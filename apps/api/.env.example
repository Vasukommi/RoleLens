# Hosted inference sends resume passages and job requirements to TypeSafe.
# Leave empty to explore the explicitly labeled sample workspace.
TYPESAFE_API_KEY=
# Job-description interpretation; resumes are assessed only by Jev.
OPENAI_API_KEY=
OPENAI_JD_MODEL=gpt-6-luna
WORKSPACE_API_KEY=
JD_REQUESTS_PER_MINUTE=6
TYPESAFE_MODEL=jev-latest
MODEL_CONFIDENCE_FLOOR=0.65
# SQLite locally; Compose defaults to PostgreSQL. Run migrations before starting.
DATABASE_URL=sqlite:///./data/rolelens.db
# Separate server-to-server intake token. Empty disables integration endpoints.
INTAKE_API_KEY=
WORKER_LEASE_SECONDS=90
WORKER_MAX_ATTEMPTS=4

# Concurrent resumes per worker; provider request quotas still apply.
WORKER_CONCURRENCY=2
