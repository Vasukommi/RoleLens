# Docker Compose configuration. For local development use each app's .env.example.
# Leave empty to explore the labeled sample workspace without model calls.
TYPESAFE_API_KEY=
# Job-description interpretation; resumes are assessed only by Jev.
OPENAI_API_KEY=
OPENAI_JD_MODEL=gpt-6-luna
# Same server-only token in API and web. Generate with: openssl rand -hex 32
WORKSPACE_API_KEY=
JD_REQUESTS_PER_MINUTE=6
TYPESAFE_MODEL=jev-latest
MODEL_CONFIDENCE_FLOOR=0.65
INTAKE_API_KEY=
POSTGRES_PASSWORD=rolelens-local
DATABASE_URL=postgresql+psycopg://rolelens:rolelens-local@db:5432/rolelens

# Concurrent resumes per worker; provider request quotas still apply.
WORKER_CONCURRENCY=2
